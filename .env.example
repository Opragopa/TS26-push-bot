TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
# TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true
# Почасовая AI-сводка только для «Контент-плана»
# AI_SUMMARY_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_SUMMARY_MODEL=gpt-5-mini
# OPENAI_SUMMARY_MAX_INPUT_CHARS=60000
# Повтор доставки почасового пакета после временной ошибки Telegram/API.
# Изменения остаются в очереди, но бот не будет повторять попытку каждый тик.
# CONTENT_PLAN_DELIVERY_RETRY_SECONDS=300

# --- Рендер плашек в After Effects ---
# Без AE_RENDER_TRIGGER_URL бот пишет задание прямо в data/ae_render_queue.json,
# и воркер заберёт его при следующем опросе (по умолчанию раз в 60 секунд).
# Это работает, только если бот и After Effects на одной машине.
# С триггером бот получает ответ сразу и может сказать «откройте нужный проект в AE».
# Токен берётся из ~/Documents/tg_sheet_monitor/ae_render_trigger.token
# (его создаёт install_ae_render_trigger_server_macos.command).
# AE_RENDER_TRIGGER_URL=http://127.0.0.1:8765/render
# AE_RENDER_TRIGGER_TOKEN=
# AE_RENDER_ENABLED=true
# Уведомлять в Telegram о результате рендера (готово / не удалось).
# AE_RENDER_NOTIFY_TELEGRAM=true
# Таблица и лист, куда бот записывает плашки.
# PLAQUE_SPREADSHEET_ID=<PLAQUE_SPREADSHEET_ID>
# PLAQUE_WORKSHEET_GID=<PLAQUE_WORKSHEET_GID>
# PLAQUE_START_ROW=2
# PLAQUE_NAME_COL=1
# PLAQUE_POSITION_COL=2
# PLAQUE_NOTE_COL=5

# AE-ready «Контент-план» для After Effects
# AE_READY_SYNC_ENABLED=true
# AE_READY_SOURCE_URL=https://docs.google.com/spreadsheets/d/<SOURCE_SPREADSHEET_ID>/edit
# AE_POSITION_REFERENCE_URL=https://docs.google.com/spreadsheets/d/<REFERENCE_SPREADSHEET_ID>/edit
# AE_READY_SPREADSHEET_ID=
# AE_READY_SPREADSHEET_TITLE=TS26 AE-ready Content Plan
# AE_READY_SHARE_EMAILS=
# AI_CORRECTION_PROVIDER=deepseek
# AI_CORRECTION_FALLBACK_PROVIDER=groq
# AI_CORRECTION_ENABLED=true
# AI_CORRECTION_MAX_CALLS_PER_SYNC=16
# AI_CORRECTION_CONFIDENCE_THRESHOLD=0.82
# AI_CORRECTION_MAX_OUTPUT_TOKENS=800
# AE_RENDER_SESSION_TOPICS_ENABLED=false
# Смена текущего источника контент-плана. Все дни рендерятся только в эту смену.
# AE_ACTIVE_SHIFT=ПРАВДА
# Интервал проверки листа локальным AE worker.
# AE_RENDER_WORKER_INTERVAL=60
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# GROQ_CORRECTION_MODEL=llama-3.3-70b-versatile
